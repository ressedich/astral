{
  "name": "astral",
  "productName": "Astral",
  "private": true,
  "version": "1.0.2",
  "description": "Astral — десктопный клиент для защищённого соединения",
  "author": "Astral",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node server/dev.mjs",
    "engine": "node server/index.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "fetch:cores": "node scripts/fetch-cores.mjs",
    "pack": "vite build && electron-builder --win --dir --x64",
    "dist": "vite build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@react-three/fiber": "^9.8.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.astral.app",
    "productName": "Astral",
    "copyright": "Copyright © 2026 Astral",
    "artifactName": "Astral-Setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!dist/**/*",
      "!server/**/*",
      "!bin/**/*",
      "!release/**/*",
      "!ios/**/*",
      "!src/**/*"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "server",
        "to": "server"
      },
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "xray.exe",
          "sing-box.exe",
          "wintun.dll",
          "libcronet.dll",
          "geoip.dat",
          "geosite.dat",
          "LICENSE",
          "LICENSE-Wintun",
          "LICENSE-sing-box",
          "README.md"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "THIRD-PARTY.md",
        "to": "THIRD-PARTY.md"
      },
      {
        "from": "licenses",
        "to": "licenses"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "shortcutName": "Astral",
      "uninstallDisplayName": "Astral ${version}",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ],
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ressedich",
        "repo": "astral"
      }
    ]
  }
}
